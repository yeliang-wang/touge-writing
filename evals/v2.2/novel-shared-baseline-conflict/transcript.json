      "returncode": 0,
      "stdout": "{\n  \"state\": {\n    \"schema_version\": 1,\n    \"project_id\": \"ferry\",\n    \"title\": \"合成小说·渡口\",\n    \"book_plan\": \"book-v1\",\n    \"chapters\": [\n      {\n        \"id\": \"night\",\n        \"title\": \"夜渡\",\n        \"plan\": \"night-plan-v1\",\n        \"accepted_text\": \"night-text-v1\",\n        \"latest_text\": \"night-candidate-v2\"\n      }\n    ],\n    \"next_action\": null\n  },\n  \"selected_chapter\": \"night\",\n  \"active_task\": null,\n  \"task_precedence\": \"Explicit chapter selection, then active task, then legacy next_action. Content acceptance is unchanged.\",\n  \"material_maps\": [],\n  \"read_full_text\": [\n    {\n      \"id\": \"book-v1\",\n      \"role\": \"current_book_plan\",\n      \"path\": \"<SYNTHETIC_RUN>/case-a/novels/ferry/版本记录/content/book-v1.md\",\n      \"status\": \"accepted\",\n      \"version\": \"1\",\n      \"sha256\": \"f39d6343be5de624e33a272721fb32906941156f8e45900977bead1b28787901\",\n      \"excerpt\": \"# 《渡口》全书方案 v1（合成）\\n\\n纯虚构短连载。洪水后的摆渡人林岑必须在省时与稳妥之间作选择。事件发生在架空的芦湾；不映射真实人物和年份。小说从夜渡到清晨，人物不靠旁白突然获得英雄身份。\\n\",\n      \"excerpt_is_full_read\": false\n    },\n    {\n      \"id\": \"night-plan-v1\",\n      \"role\": \"chapter_plan\",\n      \"path\": \"<SYNTHETIC_RUN>/case-a/novels/ferry/版本记录/content/night-plan-v1.md\",\n      \"status\": \"accepted\",\n      \"version\": \"1\",\n      \"sha256\": \"8daf321ff67113d22912fc7ea68ab6cab5305d6de12b24482e5266b6822635d5\",\n      \"excerpt\": \"# 夜渡章方案 v1（合成）\\n\\n稳定章 ID：night。继承 book-v1。承接船已离岸的状态，通过绳索松动表现眼前风险；林岑选择折回近岸固定绳索，因此迟到。不要引入新乘客或死亡。动作和对白允许虚构。结尾停在重新离岸之前。\\n\",\n      \"excerpt_is_full_read\": false\n    },\n    {\n      \"id\": \"night-text-v1\",\n      \"role\": \"accepted_text\",\n      \"path\": \"<SYNTHETIC_RUN>/case-a/novels/ferry/版本记录/content/night-text-v1.md\",\n      \"status\": \"accepted\",\n      \"version\": \"1\",\n      \"sha256\": \"15b0fe45e3209381245d80ae2ca98a7cdf8d1ce781b4e9f347e1ee7f27316cf2\",\n      \"excerpt\": \"# 夜渡 v1（合成已确认文本）\\n\\n船离了岸，林岑才发现系在船头的绳结松了一圈。他把灯挪近，绳皮里露出一道白。对岸的人影还在等，他没有再划第二桨。\\n\",\n      \"excerpt_is_full_read\": false\n    },\n    {\n      \"id\": \"night-candidate-v2\",\n      \"role\": \"target_text\",\n      \"path\": \"<SYNTHETIC_RUN>/case-a/novels/ferry/版本记录/content/night-candidate-v2.md\",\n      \"status\": \"draft\",\n      \"version\": \"2-candidate\",\n      \"sha256\": \"019033221546eeec9737493b24f6bd67009ac3913ae1a9d23489d9a5c8219e52\",\n      \"excerpt\": \"# 夜渡·续写片段（合成待审稿）\\n\\n林岑把桨横过来，船头慢慢偏回近岸。灯光在水面拖出一条弯曲的亮痕，他伸手去拢那截绳子，绳结在指间又滑了一下。\\n\\n对岸响起一声催问。他张了张嘴，先低头把灯放稳。\\n\\n“等一等。”\\n\\n水声把后半句盖住了。他没有提高嗓门，继续往回划。船底碰到浅滩时，对岸的人影已从石阶挪到了树下。\\n\\n林岑踩住船沿，把磨白的那段绳子摊在膝上。原先只露出一点白的地方，翻过来，竟有半边已经散开。他解开旧结，换一段完整的绳身重新绕紧，又用力拽了两下。\\n\\n绳子这次没有动。他把灯举向对岸，停了一会儿。该到的时候已经过了，他还站在这一边。\\n\",\n      \"excerpt_is_full_read\": false\n    }\n  ],\n  \"rules_path\": null,\n  \"open_issues_path\": null,\n  \"workspace\": \"<SYNTHETIC_RUN>/case-a\",\n  \"project_path\": \"<SYNTHETIC_RUN>/case-a/novels/ferry\"\n}\n",
