  "cases": [
    {
      "id": "novel-review-only-with-missing-material",
      "status": "passed",
      "observations": [
        "全文读取目标章、前章和实际规则，按稳定章ID执行审阅run。",
        "在机械扫描无告警时，仍指出钥匙连续性缺口、签字断言缺证、两章尾部语义重复及背景功能问题。",
        "缺失接管表只导致相关规则needs_verification，未编造设定；钥匙规则unmet。",
        "交付有位置、保留项、修订收益和损失；任务completed但稿件needs_revision。",
        "原章、邻章和版本登记哈希均未变，无新正文或accepted登记。"
      ]
    },
    {
      "id": "wechat-one-sentence-lightweight-edit",
      "status": "passed",
      "observations": [
        "读取本篇要求和规则后直接交付候选全文与一句说明，无提纲审批。",
        "只改变第5行一个句子；标题、其他段落和指定犹疑句逐字保留。",
        "候选将抽象口号改为负责人和第一版时间，没有辱骂、新经历、数据或他人心理。",
        "以轻量检查和四项实际规则覆盖交付，没有建立完整run或登记接受。",
        "局部语义呼应保留并说明范围取舍；meets_rules不是整篇最优或作者审美保证。"
      ]
    }
  ],
  "findings": [],
  "limitations": [
    "非盲测；场景与输入由独立评估Agent自行构造。",
    "语义审阅由执行本轮任务的Agent作出，不是第二位文学评审。",
    "未执行旧任务契约恢复、规则漂移或真实多账户行为。",
    "完整run输入快照未在选定证据包重复归档；清单与来源哈希已保留。"
  ],
